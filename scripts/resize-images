#!/bin/bash
set -e

# Directory paths
SRC_DIR="./public/gallery"
DEST_DIR="./public/resized"

# Sizes to generate (20=placeholders, 400=thumbnails, 2000=full view)
SIZES=(20 400 2000)

# Create resized directories and resize images
for size in "${SIZES[@]}"; do
  mkdir -p "${DEST_DIR}/${size}"
  for img in "${SRC_DIR}"/*.jpg; do
    filename=$(basename "$img")
    out="${DEST_DIR}/${size}/${filename}"
    if [ ! -f "$out" ]; then
      # Use > so 2000 only downscales, never upscales; quality 85 keeps files small
      magick "$img" -resize "${size}>" -quality 85 "$out"
      echo "Resized: $filename @ ${size}px"
    fi
  done
done

echo "Resizing complete!"
